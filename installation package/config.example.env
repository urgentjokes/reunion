# go/hi Configuration
# Copy this file to config.env to customize your settings.

# Remote server host/IP (e.g. Raspberry Pi IP address or hostname)
GOHI_HOST="192.168.0.40"

# Port used by the go/hi web server
GOHI_PORT="8003"

# SSH username for remote deployment to your Raspberry Pi / Linux server
REMOTE_USER="pi"

# Optional: Custom prompt prefix (defaults to "(Hello)")
GOHI_PROMPT_PREFIX="(Hello)"
