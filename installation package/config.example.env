# nostalgia Configuration
# Copy this file to config.env to customize your settings.

# Remote server host/IP (e.g. Raspberry Pi IP address or hostname)
GOHI_HOST="192.168.0.40"

# Port used by the nostalgia web server
GOHI_PORT="8003"

# SSH username for remote deployment to your Raspberry Pi / Linux server
REMOTE_USER="pi"

# Keep a synced local HTML backup copy (~/.gohi/backup.html) alongside remote logging:
# - Set to "true" for Use Case 3 (Remote Server + Local Backup)
# - Set to "false" for Use Case 2 (Remote Server Only - no local HTML backup)
ENABLE_LOCAL_BACKUP=true

# Optional: Custom prompt prefix (defaults to "(Hello)")
GOHI_PROMPT_PREFIX="(Hello)"
